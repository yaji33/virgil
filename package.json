{
  "name": "vigil",
  "version": "0.1.0",
  "description": "Deterministic Policy + Multi-Agent Risk Guardian for Binance Agent OS",
  "type": "module",
  "scripts": {
    "dev": "vite web --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc && pnpm build:web",
    "build:web": "tsc -p web/tsconfig.json && vite build web",
    "preview": "vite preview web --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "demo:plans": "tsx scripts/demo-plans.ts",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "server": "tsx --env-file=.env scripts/server.ts",
    "smoke:postgres": "tsx --env-file=.env scripts/smoke-postgres.ts",
    "migrate:local": "tsx --env-file=.env scripts/migrate-local.ts",
    "lint": "tsc --noEmit && tsc -p web/tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "^2.115.0",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "5.4.21",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
